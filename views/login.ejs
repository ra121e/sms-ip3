<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ログイン</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    body {
      font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "Hiragino Sans", "Helvetica Neue", Arial, sans-serif;
    }
  </style>
</head>
<body class="min-h-screen bg-gray-50 flex items-center justify-center px-4">
  <main class="w-full max-w-sm">
    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 px-8 py-10">
      <h1 class="text-2xl font-semibold text-gray-900 text-center tracking-tight mb-1">ログイン</h1>
      <p class="text-sm text-gray-400 text-center mb-8">アカウント情報を入力してください</p>

      <% if (typeof error !== "undefined" && error) { %>
        <p class="text-sm text-red-500 bg-red-50 rounded-lg px-3 py-2 mb-6 text-center"><%= error %></p>
      <% } %>

      <form action="/login" method="POST" class="space-y-5">
        <div>
          <label for="userId" class="block text-xs font-medium text-gray-500 mb-1.5">ユーザID</label>
          <input type="text" id="userId" name="userId" value="<%= typeof userId !== 'undefined' ? userId : '' %>" required
            class="w-full rounded-xl border border-gray-200 bg-gray-50 px-4 py-3 text-sm text-gray-900 outline-none transition focus:bg-white focus:border-gray-900 focus:ring-1 focus:ring-gray-900">
        </div>

        <div>
          <label for="password" class="block text-xs font-medium text-gray-500 mb-1.5">パスワード</label>
          <input type="password" id="password" name="password" required
            class="w-full rounded-xl border border-gray-200 bg-gray-50 px-4 py-3 text-sm text-gray-900 outline-none transition focus:bg-white focus:border-gray-900 focus:ring-1 focus:ring-gray-900">
        </div>

        <button type="submit"
          class="w-full rounded-xl bg-gray-900 hover:bg-gray-700 text-white text-sm font-medium py-3 mt-2 transition">
          ログイン
        </button>
      </form>
    </div>
  </main>
</body>
</html>